# ==============================================================================
# BharatStandards AI - Environment Configuration Template
# ==============================================================================

# Application Metadata
APP_NAME="BharatStandards AI"
APP_ENV=development
DEBUG=true
PORT=8000
HOST=0.0.0.0

# CORS Configuration (Comma-separated origins)
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:5173

# Database (PostgreSQL with pgvector)
POSTGRES_USER=bharat_user
POSTGRES_PASSWORD=bharat_secure_password
POSTGRES_DB=bharat_standards_db
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
DATABASE_URL=postgresql://bharat_user:bharat_secure_password@localhost:5432/bharat_standards_db

# MongoDB Database Configuration
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=bharat_standards
MONGODB_ENABLED=true

# API Prefix
API_V1_PREFIX=/api

# Frontend Configuration
VITE_API_BASE_URL=http://localhost:8000/api
VITE_APP_TITLE="BharatStandards AI"
