# Production environment configuration for Netlify deployment
# If your backend is hosted separately (e.g., Render, Railway, AWS, Fly.io),
# set VITE_API_BASE_URL to your backend API URL, for example:
# VITE_API_BASE_URL=https://bharatstandards-api.onrender.com/api
#
# If you use Netlify reverse proxy (recommended to avoid CORS), leave it as /api:
VITE_API_BASE_URL=/api
VITE_APP_TITLE="BharatStandards AI"
